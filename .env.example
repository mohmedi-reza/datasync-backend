# Server
PORT=3000
NODE_ENV=development

# Optional shared secret. If set, Android must send:
# Authorization: Bearer <AUTH_TOKEN>
AUTH_TOKEN=

# Max messages kept (oldest are dropped)
MAX_MESSAGES=1000

# Durable storage (recommended for Vercel).
# Create a free Redis DB at https://upstash.com then paste:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
